<mujoco model="el_a3_gripper scene">
  <compiler angle="radian"/>

  <statistic center="0 0 0.15" extent="0.6"/>

  <option timestep="0.001" iterations="50" solver="Newton" cone="elliptic">
    <flag gravity="disable" energy="enable"/>
  </option>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-30"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <mesh name="l1" content_type="model/stl" file="../meshes/l1.stl"/>
    <mesh name="l2" content_type="model/stl" file="../meshes/l2.stl"/>
    <mesh name="l3" content_type="model/stl" file="../meshes/l3.stl"/>
    <mesh name="l4" content_type="model/stl" file="../meshes/l4.stl"/>
    <mesh name="l5" content_type="model/stl" file="../meshes/l5.stl"/>
    <mesh name="l6" content_type="model/stl" file="../meshes/l6.stl"/>
    <mesh name="el05_l6" content_type="model/stl" file="../meshes/el05_l6.stl"/>
    <!-- yam 可动双指 + 滑轨安装板（来自 yam_arm_mujoco_standalone 的 gripper.stl，
         已切除电机圆筒段，仅保留 z∈[45,63.5]mm 滑轨板；坐标已烘焙到 mount 系） -->
    <mesh name="yam_gripper_rail" content_type="model/stl" file="../meshes/yam_gripper_rail.stl"/>
    <mesh name="yam_tip_left" content_type="model/stl" file="../../../yam_arm_mujoco_standalone/yam_arm_standalone/yam/assets/tip_left.stl"/>
    <mesh name="yam_tip_right" content_type="model/stl" file="../../../yam_arm_mujoco_standalone/yam_arm_standalone/yam/assets/tip_right.stl"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" contype="4" conaffinity="4"/>

    <body name="target" pos="0.0 -0.3 0.2" mocap="true">
      <geom type="sphere" size="0.004" contype="0" conaffinity="0" rgba="1 0 0 0.8"/>
    </body>

    <geom name="l1_visual" pos="-0.000643355 0 0.059" quat="1 0 0 0" type="mesh" contype="0" conaffinity="0"
      rgba="0.301961 0.290196 0.262745 1" mesh="l1"/>
    <body name="l1_link_urdf_asm" pos="0 0 0.06" quat="1.32679e-06 1 0 0">
      <inertial pos="-0.00232762 -0.00161986 0.0421389" quat="0.837633 0.535962 -0.0926092 0.0503874" mass="0.105244" diaginertia="0.000165368 0.000121606 9.30122e-05"/>
      <joint name="L1_joint" pos="0 0 0" axis="0 0 -1" range="-2.79253 2.79253" actuatorfrcrange="-14 14" damping="0.1" frictionloss="0.1"/>
      <geom name="l2_visual" pos="-0.000642857 0 0.001" quat="1.32679e-06 1 0 0" type="mesh" contype="0" conaffinity="0"
        rgba="0.972549 0.529412 0.00392157 1" mesh="l2"/>
      <body name="l2_l3_urdf_asm" pos="-0.00964286 0 -0.069" quat="0.707105 -0.707108 0 0">
        <inertial pos="0.0949957 1.32911e-06 0.000626283" quat="0.499818 0.50015 0.49985 0.500182" mass="0.836196" diaginertia="0.00708317 0.00707892 0.000419405"/>
        <joint name="L2_joint" pos="0 0 0" axis="0 0 1" range="0 3.66519" actuatorfrcrange="-14 14" damping="0.1" frictionloss="0.1"/>
        <geom name="l3_visual" pos="0.009 -0.07 0" quat="0.707105 -0.707108 0 0" type="mesh" contype="0" conaffinity="0"
          rgba="0.301961 0.290196 0.262745 1" mesh="l3"/>
        <body name="l3_lnik_urdf_asm" pos="0.19 0 0">
          <inertial pos="-0.0743466 -0.0535452 -0.00326782" quat="0.233153 0.612994 0.347208 0.670317" mass="0.262025" diaginertia="0.00134684 0.00131972 0.000299972"/>
          <joint name="L3_joint" pos="0 0 0" axis="0 0 1" range="-4.01426 0" actuatorfrcrange="-14 14" damping="0.1" frictionloss="0.1"/>
          <geom name="l4_visual" pos="-0.181 -0.07 0" quat="0.707105 -0.707108 0 0" type="mesh" contype="0" conaffinity="0"
            rgba="0.972549 0.529412 0.00392157 1" mesh="l4"/>
          <body name="l4_l5_urdf_asm" pos="-0.185 0.064 0" quat="1.32679e-06 -1 0 0">
            <inertial pos="-0.0242818 -0.0298393 0.000368105" quat="0.663117 0.6705 -0.235274 -0.235269" mass="0.55715" diaginertia="0.00100222 0.000993544 0.000180152"/>
            <joint name="L4_joint" pos="0 0 0" axis="0 0 -1" range="-1.0472 1.5708" actuatorfrcrange="-6 6" damping="0.05" frictionloss="0.05"/>
            <geom name="l5_visual" pos="0.004 0.134 0" quat="0.707105 0.707108 0 0" type="mesh" contype="0" conaffinity="0"
              rgba="0.301961 0.290196 0.262745 1" mesh="l5"/>
            <body name="part_9" pos="-0.0492 -0.038 0" quat="0.707105 -0.707108 0 0">
              <inertial pos="0.00527533 0 -0.0216678" quat="0.980841 0 -0.194812 0" mass="0.0392349" diaginertia="1.62459e-05 1.4787e-05 4.67101e-06"/>
              <joint name="L5_joint" pos="0 0 0" axis="0 0 1" range="-1.5708 1.5708" actuatorfrcrange="-6 6" damping="0.05" frictionloss="0.05"/>
              <geom name="l6_visual" pos="0.0532 0 0.173" quat="1.32679e-06 1 0 0" type="mesh" contype="0" conaffinity="0"
                rgba="0.972549 0.529412 0.00392157 1" mesh="l6"/>
              <body name="l5_l6_urdf_asm" pos="0.00685 0 0.039" quat="0.499998 -0.5 0.500002 -0.5">
                <inertial pos="7.89154e-06 -9.46048e-05 0.0599853" quat="0.718801 -0.00441624 0.0042182 0.695189" mass="0.678292" diaginertia="0.00387593 0.00345206 0.000635307"/>
                <joint name="L6_joint" pos="0 0 0" axis="0 0 1" range="-0.79 0.79" actuatorfrcrange="-6 6" damping="0.05" frictionloss="0.05"/>
                <geom name="el05_l6_visual" pos="0 0 -0.0755" quat="1.32679e-06 1 0 0" type="mesh" contype="0" conaffinity="0"
                  rgba="0.301961 0.290196 0.262745 1" mesh="el05_l6"/>

                <!-- yam 可动双指：装在 EL-A3 末端法兰上，只保留 yam 夹爪的滑轨薄板(18.5mm)，
                     yam 电机圆筒已切除（EL-A3 腕部自带 L7 电机，不做重复）。
                     末端总长与原固定 jaw 版本一致，tip site 恢复到原位 L6 z=-0.194。
                     双指为滑动关节，经 <equality> 与 L7(夹爪通道) 耦合：
                     L7 = 0°    → 指尖并拢；L7 = -90° → 全开（每指行程 46.95 mm）。
                     指尖可碰撞（与方块/桌面/地面），互不碰撞，能真实夹取物体。
                     mount z=-0.053：手指根部（mount 系 z=+0.053）正好贴住法兰面（L6 z=-0.106），
                     滑轨板背面(mount z=+0.045→L6 z=-0.098)嵌入腕口 8mm，正面凸出法兰 10.5mm。 -->
                <body name="yam_gripper_mount" pos="0 0 -0.053" quat="0 1 0 0">
                  <inertial pos="0 0 0.06" mass="0.05" diaginertia="0.0001 0.0001 0.0001"/>
                  <geom name="yam_gripper_rail" type="mesh" mesh="yam_gripper_rail" rgba="0.72 0.72 0.75 1" contype="0" conaffinity="0"/>
                  <!-- 开合方向按用户要求（2026-11-11）与上一版相反：只把两指滑动轴
                       的符号对调（0 1 0 <-> 0 -1 0），张开时每根手指即向上一版
                       的相反方向移动。并拢位(q=0)、行程(47mm/指)、L7 映射
                       (equality -0.0299)、关节名、网格归属(finger_left=yam_tip_left)、
                       工具坐标系全部不变；几何内容仍为 yam 原生摆放。
                       叠加工具(view_model_overlay)对 yam 子树做同款轴翻转，
                       保证合并场景四指依旧成对同向。 -->
                  <body name="finger_left" pos="0.0445119 -0.0239931 0.0566829" quat="0 0.70711 0.70711 0">
                    <inertial mass="0.07" pos="0.014 -0.042 -0.022" diaginertia="5e-05 5e-05 5e-05"/>
                    <joint name="finger_left_joint" type="slide" axis="0 -1 0" range="0 0.04695" damping="0.2" frictionloss="0.05"/>
                    <geom name="finger_left_visual" pos="0.00999321 -0.0914614 0.129783" type="mesh" mesh="yam_tip_left"
                      rgba="0.6 0.79 0.92 1" contype="2" conaffinity="5" friction="1.0 0.02 0.001"/>
                  </body>
                  <body name="finger_right" pos="-0.0445119 0.0239931 0.0566829" quat="0 0.70711 0.70711 0">
                    <inertial mass="0.07" pos="-0.014 0.042 -0.022" diaginertia="5e-05 5e-05 5e-05"/>
                    <joint name="finger_right_joint" type="slide" axis="0 1 0" range="0 0.04695" damping="0.2" frictionloss="0.05"/>
                    <geom name="finger_right_visual" pos="-0.0379932 -0.00133753 0.129783" type="mesh" mesh="yam_tip_right"
                      rgba="0.6 0.79 0.92 1" contype="2" conaffinity="5" friction="1.0 0.02 0.001"/>
                  </body>
                  <site name="gripper_tip_site" pos="0 0 0.141" size="0.005" rgba="0 1 0 1" type="sphere"/>
                  <!--  末端执行器上显示红（X）、绿（Y）、蓝（Z）三色坐标轴  -->
                  <geom name="ee_x_axis" type="cylinder" fromto="0 0 0.141 -0.08 0 0.141" size="0.002" rgba="1 0 0 1" contype="0" conaffinity="0"/>
                  <geom name="ee_y_axis" type="cylinder" fromto="0 0 0.141 0 -0.08 0.141" size="0.002" rgba="0 1 0 1" contype="0" conaffinity="0"/>
                  <geom name="ee_z_axis" type="cylinder" fromto="0 0 0.141 0 0 0.221" size="0.002" rgba="0 0 1 1" contype="0" conaffinity="0"/>
               </body>

                <!-- L7 载体：空 body，仅作为夹爪电机的仿真通道（与实机 7 号电机对应） -->
                <body name="gripper_link" pos="0 0 -0.074">
                  <inertial pos="0 0 0" mass="0.05" diaginertia="0.0001 0.0001 0.0001"/>
                  <joint name="L7_joint" pos="0 0 0" axis="0 0 1" range="-1.5708 1.5708" actuatorfrcrange="-6 6" damping="0.05" frictionloss="0.05"/>
               </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <sensor>
    <framepos name="gripper_tip_site_pos" objtype="site" objname="gripper_tip_site"/>
    <framequat name="gripper_tip_site_quat" objtype="site" objname="gripper_tip_site"/>
    <jointactuatorfrc name="L1_frc" joint="L1_joint"/>
    <jointactuatorfrc name="L2_frc" joint="L2_joint"/>
    <jointactuatorfrc name="L3_frc" joint="L3_joint"/>
    <jointactuatorfrc name="L4_frc" joint="L4_joint"/>
    <jointactuatorfrc name="L5_frc" joint="L5_joint"/>
    <jointactuatorfrc name="L6_frc" joint="L6_joint"/>
    <jointactuatorfrc name="L7_frc" joint="L7_joint"/>
  </sensor>

  <equality>
    <!-- 双指开合 = f(L7): q = -0.0299 * L7
         L7=-90° → q=47mm（全开）, L7=0° → q=0（指尖并拢）, L7&gt;0 → 保持并拢并施加夹紧力 -->
    <joint name="finger_L_couple" joint1="finger_left_joint" joint2="L7_joint" polycoef="0 -0.0299 0 0"/>
    <joint name="finger_R_couple" joint1="finger_right_joint" joint2="L7_joint" polycoef="0 -0.0299 0 0"/>
  </equality>

  <actuator>
    <position name="L1" joint="L1_joint" kp="100" ctrlrange="-2.79253 2.79253" forcerange="-14 14"/>
    <position name="L2" joint="L2_joint" kp="100" ctrlrange="0 3.66519" forcerange="-14 14"/>
    <position name="L3" joint="L3_joint" kp="100" ctrlrange="-4.01426 0" forcerange="-14 14"/>
    <position name="L4" joint="L4_joint" kp="80" ctrlrange="-1.0472 1.5708" forcerange="-6 6"/>
    <position name="L5" joint="L5_joint" kp="50" ctrlrange="-1.5708 1.5708" forcerange="-6 6"/>
    <position name="L6" joint="L6_joint" kp="50" ctrlrange="-1.5708 1.5708" forcerange="-6 6"/>
    <position name="L7" joint="L7_joint" kp="20" ctrlrange="-1.5708 1.5708" forcerange="-6 6"/>
  </actuator>
</mujoco>
